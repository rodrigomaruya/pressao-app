datasource db {
  provider = "postgresql"
}
 
generator client {
  provider = "prisma-client"
   output   = "../src/generated"
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dados pessoais
  dateOfBirth   DateTime?       // Data de nascimento
  phone         String?         // Telefone para WhatsApp
  
  // Configurações de lembrete
  reminderTime  String    @default("08:00") // HH:MM
  reminderEnabled Boolean @default(true)
  
  // Relacionamentos
  measurements  Measurement[]
  reminders     ReminderLog[]
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}


model Measurement {
  id          String   @id @default(cuid())
  userId      String
  systolic    Int      // Pressão sistólica (ex: 120)
  diastolic   Int      // Pressão diastólica (ex: 80)
  pulse       Int?     // Pulso (ex: 72)
  measuredAt  DateTime @default(now())
  notes       String?
  
  user        User     @relation(fields: [userId], references: [id])

  
  @@index([userId, measuredAt])
}

model ReminderLog {
  id          String   @id @default(cuid())
  userId      String
  sentAt      DateTime @default(now())
  type        String   // "PUSH", "EMAIL"
  clicked     Boolean  @default(false)
  
  user        User     @relation(fields: [userId], references: [id])
}